[Unit]
Description=CommyPanel agent (privileged host operations)
Documentation=https://github.com/emrecanful/commypanel
After=network-online.target docker.service nginx.service
Wants=docker.service

[Service]
Type=simple
ExecStart=@@PREFIX@@/current/bin/commypanel-agent \
    --socket /run/commypanel/agent.sock \
    --socket-group commypanel \
    --terminal-socket /run/commypanel-terminal/terminal.sock \
    --terminal-socket-group www-data \
    --dbtool-socket /run/commypanel-dbtool/dbtool.sock \
    --dbtool-socket-group www-data \
    --tools-port @@TOOLS_PORT@@ \
    --data-dir @@DATA_DIR@@ \
    --state-dir /var/lib/commypanel-agent \
    --nginx-sites-dir /etc/nginx/commypanel \
    --allow-uid @@PANEL_UID@@
Restart=always
RestartSec=2
RuntimeDirectory=commypanel commypanel-terminal commypanel-dbtool
RuntimeDirectoryMode=0755
# The agent's own folder: scratch files, the record of its dumps, TLS private keys,
# the ACME account key and the ACME challenge files. Owned by root and outside the
# data directory, which the panel user owns. 0711 lets nginx reach the challenge
# folder inside it (it lists nothing); every other folder in it is root only.
StateDirectory=commypanel-agent
StateDirectoryMode=0711
LimitNOFILE=65536

# The agent needs root for Docker and nginx, but not much else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
